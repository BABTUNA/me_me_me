# Canonical public origin, including https://. Set this before building on hosts
# other than Vercel, or to override Vercel's production domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Bartie control api behind Caddy (see github.com/BABTUNA/Bartie/deploy). The
# live console on /bartie/live and in the Bartie post fetches it from the browser.
# NEXT_PUBLIC_BARTIE_API_URL=https://api.your-domain.com
