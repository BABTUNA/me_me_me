# Canonical public origin, including https://. Set this before building on hosts
# other than Vercel, or to override Vercel's production domain.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Super Bartie control api behind Caddy (see github.com/BABTUNA/SuperBartie/deploy).
# The console on /super-bartie/live, the browser on /super-bartie/data, and the
# Super Bartie post fetch it from the browser.
# NEXT_PUBLIC_SUPER_BARTIE_API_URL=https://api.your-domain.com
